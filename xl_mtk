#!/bin/bash
# xl_mtk — drive the XNU loader on MediaTek phones over USB.
# Boards: x6826b (Infinix Hot 20), selene (Redmi 10), eos (Redmi Note 11 4G China).
# Strictly bound to target device: <HAKIOS_SERIAL>

SCRIPT_NAME="$(basename "$0")"
if [ "$SCRIPT_NAME" = "xl_eos" ]; then
	DEFAULT_BOARD="eos"
elif [ "$SCRIPT_NAME" = "xl_x6826b" ]; then
	DEFAULT_BOARD="x6826b"
else
	DEFAULT_BOARD="selene"
fi

BOARD="${BOARD:-$DEFAULT_BOARD}"

# Check if first argument is a board name
case "$1" in
	selene|eos|x6826b)
		BOARD="$1"
		shift
		;;
esac

DEVICE="${HAKIOS_SERIAL:?set HAKIOS_SERIAL to your phone adb serial}"
HERE="$(cd "$(dirname "$0")" && pwd)"
cd "$HERE"

K=xnu-src/xnu-8796.121.2/BUILD/obj/DEVELOPMENT_ARM64_BCM2837/mach.development.bcm2837
[ -f "$K" ] || K=prebuilt/mach.development.bcm2837
L=xnuloader/loader.efi
[ -f "$L" ] || L=prebuilt/loader.efi
mkdir -p logs

adb_cmd() { adb -s "$DEVICE" "$@"; }
fb_cmd() { fastboot -s "$DEVICE" "$@"; }

state() {
	if fb_cmd devices 2>/dev/null | grep -q "$DEVICE"; then
		echo "fastboot"
	elif adb_cmd get-state 2>/dev/null | grep -q "device"; then
		echo "android"
	else
		echo "absent"
	fi
}

wait_for() { # wait_for <state> <seconds>
	local target="$1" max_sec="$2" i
	for ((i = 0; i < max_sec; i += 2)); do
		[ "$(state)" = "$target" ] && return 0
		sleep 2
	done
	return 1
}

enter_fastboot() {
	case "$(state)" in
		fastboot) return 0 ;;
		android)
			echo "xl ($BOARD): rebooting to bootloader..."
			adb_cmd reboot bootloader
			wait_for fastboot 45 || { echo "xl ($BOARD): device did not reach fastboot"; return 1; }
			;;
		absent)
			echo "xl ($BOARD): device $DEVICE not detected (check USB cable/authorization)"
			return 1
			;;
	esac
}

boot_image() {
	local img="${1:-xnu-$BOARD.img}"
	enter_fastboot || return 1
	echo "xl ($BOARD): booting $img via fastboot boot..."
	fb_cmd boot "$img"
}

reboot_android() {
	case "$(state)" in
		fastboot) fb_cmd reboot ;;
		android) adb_cmd reboot ;;
		absent) echo "xl ($BOARD): device not found" ;;
	esac
}

build_payload_and_img() {
	local rd="${XL_RAMDISK:-userland/root.apfs}"
	local cmd="${XL_CMDLINE:- -v}"
	local payload_args="loader.efi=$L kernel=$K"
	if [ -f "$rd" ]; then
		payload_args="$payload_args ramdisk=$rd"
	fi
	echo "xl ($BOARD): building mtkloader for $BOARD..."
	BOARD="$BOARD" "$HERE/mtkloader/build.sh"
	echo "xl ($BOARD): creating payload with $payload_args (cmdline: '$cmd')..."
	python3 xnuloader/mkpayload.py -o build-payload.bin $payload_args --cmdline="$cmd"
	python3 mkxnuimg_mtk.py --board "$BOARD" -p build-payload.bin -o "xnu-$BOARD.img"
}

case "$1" in
	state)
		echo "Device: $DEVICE | Board: $BOARD | State: $(state)"
		;;
	enter)
		enter_fastboot
		;;
	reboot)
		reboot_android
		;;
	build)
		build_payload_and_img
		;;
	boot)
		shift
		build_payload_and_img
		boot_image "xnu-$BOARD.img"
		;;
	*)
		echo "Usage: $0 [x6826b|selene|eos] {state|enter|build|boot|reboot}"
		exit 1
		;;
esac
